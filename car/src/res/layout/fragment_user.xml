<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/homeShortcutsScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_120"
        android:fillViewport="true"
        android:paddingLeft="@dimen/car_side_padding"
        android:paddingRight="@dimen/car_side_padding"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/tvUserHome"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/tvHistory" style="@style/CarHomeShortcut" android:nextFocusLeft="@id/tvSetting">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_history" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="历史" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tvLive" style="@style/CarHomeShortcut">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_live" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="直播" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tvSearch" style="@style/CarHomeShortcut">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_search" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="搜索" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tvPush" style="@style/CarHomeShortcut">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_push" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="推送" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tvFavorite" style="@style/CarHomeShortcut">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_collect" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="收藏" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tvSetting" style="@style/CarHomeShortcut" android:nextFocusRight="@id/tvHistory">
                <ImageView style="@style/CarHomeShortcutIcon" android:src="@drawable/icon_setting" />
                <TextView style="@style/CarHomeShortcutLabel" android:text="设置" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_15"
        app:tv_selectedItemIsCentered="false"
        app:tv_verticalSpacingWithMargins="@dimen/vs_15" />
</LinearLayout>
