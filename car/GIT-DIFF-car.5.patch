diff --git a/car/tests/VideoEnhancePresetTest.java b/car/tests/VideoEnhancePresetTest.java
new file mode 100644
index 0000000..db82b31
--- /dev/null
+++ b/car/tests/VideoEnhancePresetTest.java
@@ -0,0 +1,38 @@
+import java.util.HashSet;
+import java.util.Set;
+import xyz.doikki.videoplayer.render.VideoEnhancePreset;
+
+/** Host checks for persisted IDs, migration and distinct shader inputs (no Android runtime). */
+public final class VideoEnhancePresetTest {
+    private static void check(boolean ok, String message) {
+        if (!ok) throw new AssertionError(message);
+    }
+
+    public static void main(String[] args) {
+        check(VideoEnhancePreset.all().size() == 8, "Eight selectable presets");
+        Set<String> curves = new HashSet<>();
+        for (int i = 0; i < VideoEnhancePreset.all().size(); i++) {
+            VideoEnhancePreset p = VideoEnhancePreset.all().get(i);
+            check(p.id == i && VideoEnhancePreset.forMode(i) == p, "Stable ID " + i);
+            check(VideoEnhancePreset.modeFromPrefValue(i) == i, "Integer round trip " + i);
+            check(VideoEnhancePreset.modeFromPrefValue(Integer.toString(i)) == i, "String migration " + i);
+            float[] values = {p.saturation, p.contrast, p.brightness, p.red, p.green, p.blue};
+            for (float value : values) check(!Float.isNaN(value) && !Float.isInfinite(value), "Finite shader input");
+            check(p.saturation >= 0 && p.contrast > 0 && p.red > 0 && p.green > 0 && p.blue > 0, "Valid transform");
+            check(!p.name.isEmpty() && !p.description.isEmpty(), "Label and guidance");
+            curves.add(p.saturation + "/" + p.contrast + "/" + p.brightness + "/" + p.red + "/" + p.green + "/" + p.blue);
+        }
+        check(curves.size() == 8, "Every preset has distinct parameters");
+        VideoEnhancePreset off = VideoEnhancePreset.forMode(0), vivid = VideoEnhancePreset.forMode(1);
+        check(off.saturation == 1 && off.contrast == 1 && off.brightness == 0 && off.red == 1 && off.green == 1 && off.blue == 1, "Original is identity");
+        check(vivid.saturation == 1.35f && vivid.contrast == 1.12f && vivid.brightness == .03f, "Legacy 臻彩 retained");
+        check(VideoEnhancePreset.modeFromPrefValue(Boolean.TRUE) == 1, "Old true -> 臻彩");
+        check(VideoEnhancePreset.modeFromPrefValue(Boolean.FALSE) == 0, "Old false -> original");
+        for (Object invalid : new Object[]{null, -1, 8, Integer.MAX_VALUE, "broken", "99999999999999999"}) {
+            check(VideoEnhancePreset.modeFromPrefValue(invalid) == 0, "Corrupt preference -> original: " + invalid);
+        }
+        try { VideoEnhancePreset.all().clear(); throw new AssertionError("Mutable list"); }
+        catch (UnsupportedOperationException expected) { }
+        System.out.println("PASS: 8 presets, stable IDs, legacy migration, corrupt preference fallback, distinct immutable curves");
+    }
+}
diff --git a/car/tests/compare_presets.py b/car/tests/compare_presets.py
new file mode 100644
index 0000000..9fd5eee
--- /dev/null
+++ b/car/tests/compare_presets.py
@@ -0,0 +1,42 @@
+"""Recompute car.5 pixel evidence. Requires Pillow and NumPy; no emulator operations."""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+parser = argparse.ArgumentParser()
+parser.add_argument('screenshots', type=Path, help='Directory containing preset-0.png ... preset-7.png')
+parser.add_argument('--output', type=Path, help='Optional output JSON path')
+args = parser.parse_args()
+names = ['原画', '臻彩', '自然', '影院', '鲜艳', '柔和', '明亮', '暖色']
+video_roi = (250, 180, 1050, 650)
+ui_roi = (1250, 100, 2700, 700)
+original = Image.open(args.screenshots / 'preset-0.png').convert('RGB')
+video_original = np.asarray(original.crop(video_roi), dtype=float)
+ui_original = np.asarray(original.crop(ui_roi), dtype=float)
+rows = []
+for mode, name in enumerate(names):
+    path = args.screenshots / ('preset-%d.png' % mode)
+    image = Image.open(path).convert('RGB')
+    if image.size != (2880, 1620):
+        raise ValueError('Expected a 2880x1620 capture: ' + str(path))
+    rgb = np.asarray(image.crop(video_roi), dtype=float)
+    hsv = np.asarray(image.crop(video_roi).convert('HSV'), dtype=float)
+    row = dict(mode=mode, name=name, screenshot=path.name, size=list(image.size),
+               mean_rgb=np.round(rgb.mean(axis=(0, 1)), 3).tolist(),
+               mean_saturation=round(float(hsv[:, :, 1].mean()), 3),
+               mean_value=round(float(hsv[:, :, 2].mean()), 3),
+               video_mean_absolute_difference=round(float(np.abs(rgb-video_original).mean()), 3),
+               ui_mean_absolute_difference=round(float(np.abs(np.asarray(image.crop(ui_roi), dtype=float)-ui_original).mean()), 3))
+    rows.append(row)
+    print(json.dumps(row, ensure_ascii=False))
+result = dict(video_roi=video_roi, ui_roi=ui_roi, rows=rows)
+if args.output:
+    args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+assert all(row['video_mean_absolute_difference'] > .1 for row in rows[1:]), 'No video change'
+assert all(row['ui_mean_absolute_difference'] == 0 for row in rows), 'Sampled UI changed'
+assert rows[4]['mean_saturation'] > rows[0]['mean_saturation'], 'Vivid saturation did not increase'
+assert rows[6]['mean_value'] > rows[0]['mean_value'], 'Bright value did not increase'
+print('PASS: 8 screenshots; 7 distinct video changes, expected vivid/bright directions, sampled UI unchanged')
