<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#8012261D" />
            <stroke android:width="@dimen/car_stroke_hair" android:color="#339AB8AB" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/car_surface_control_pressed" />
            <stroke android:width="@dimen/car_stroke_mid" android:color="@color/car_outline_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="@color/car_accent_blue" android:endColor="@color/car_accent_blue_deep" />
            <stroke android:width="@dimen/car_stroke_focus" android:color="@color/car_outline_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#A612261D" />
            <stroke android:width="@dimen/car_stroke_hair" android:color="#4D6FF2C6" />
        </shape>
    </item>
</selector>
