<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_control_bg" />
            <stroke android:width="2px" android:color="@color/dialog_control_stroke_focused" />
            <corners android:radius="12px" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_input_bg" />
            <stroke android:width="2px" android:color="@color/dialog_control_stroke" />
            <corners android:radius="12px" />
        </shape>
    </item>
</selector>
