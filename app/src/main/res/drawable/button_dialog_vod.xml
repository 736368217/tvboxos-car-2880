<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页次要按钮：未选中也要有可见的深色底与描边，避免只剩一行文字。
     选中/按下沿用高亮蓝，保证焦点可辨识。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="@color/color_BD0CADE2" />
            <stroke android:width="1mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="@color/color_BD0CADE2" />
            <stroke android:width="1mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="@color/color_BD0CADE2" />
            <stroke android:width="1mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="@color/color_CC353744" />
            <stroke android:width="1mm" android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>
