<?xml version="1.0" encoding="utf-8"?>
<!-- Low-profile transport dock. One surface, one radius, no stacked cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/car_radius_lg" />
    <gradient
        android:angle="270"
        android:startColor="#E612291F"
        android:endColor="#F20A1813" />
    <stroke
        android:width="@dimen/car_stroke_hair"
        android:color="#336FF2C6" />
</shape>
