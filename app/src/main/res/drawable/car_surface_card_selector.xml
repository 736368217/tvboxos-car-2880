<?xml version="1.0" encoding="utf-8"?>
<!-- Card/item state list: pressed -> cyan rim lift, focused -> raised + cyan rim, idle -> flat card. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/car_radius_md" />
            <solid android:color="@color/car_surface_card_pressed" />
            <stroke
                android:width="@dimen/car_stroke_mid"
                android:color="@color/car_outline_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/car_radius_md" />
            <solid android:color="@color/car_surface_card_raised" />
            <stroke
                android:width="@dimen/car_stroke_focus"
                android:color="@color/car_outline_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/car_radius_md" />
            <solid android:color="@color/car_surface_card" />
            <stroke
                android:width="@dimen/car_stroke_hair"
                android:color="@color/car_outline_idle" />
        </shape>
    </item>
</selector>
