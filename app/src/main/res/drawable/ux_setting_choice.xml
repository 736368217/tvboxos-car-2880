<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/car_accent_blue" /><corners android:radius="20px" /><stroke android:width="3px" android:color="@color/car_accent_cyan" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/car_accent_blue_deep" /><corners android:radius="20px" /><stroke android:width="3px" android:color="@color/car_accent_cyan" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/car_surface_card_pressed" /><corners android:radius="20px" /><stroke android:width="3px" android:color="@color/car_accent_cyan" /></shape></item>
    <item><shape><solid android:color="@color/car_surface_card_raised" /><corners android:radius="20px" /><stroke android:width="1px" android:color="@color/car_outline_idle" /></shape></item>
</selector>
