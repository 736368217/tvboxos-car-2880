<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:tag="2880,1620" android:background="@color/car_bg">
    <FrameLayout android:layout_width="2880px" android:layout_height="1620px">
        <TextView android:id="@+id/ux_search_back" android:layout_width="180px" android:layout_height="96px"
            android:layout_marginLeft="60px" android:layout_marginTop="40px" android:text="返回"
            android:drawableLeft="@drawable/aether_back" android:drawablePadding="10px" android:textSize="28px" android:textColor="@color/aether_cyan_focus" android:gravity="center"
            android:contentDescription="返回上一页" android:focusable="true" android:background="@drawable/ux_setting_choice" />
        <EditText android:id="@+id/etSearch" android:layout_width="2100px" android:layout_height="140px"
            android:layout_marginLeft="250px" android:layout_marginTop="40px"
            android:background="@drawable/ux_search_input" android:paddingLeft="40px" android:paddingRight="40px"
            android:hint="搜索片名 / 首字母简拼" android:singleLine="true" android:inputType="text"
            android:imeOptions="actionSearch" android:textSize="42px" android:textStyle="bold"
            android:textColor="@color/car_text" android:textColorHint="@color/car_text_muted" />
        <TextView android:id="@+id/tvSearch" android:layout_width="210px" android:layout_height="140px"
            android:layout_marginLeft="2390px" android:layout_marginTop="40px" android:drawableTop="@drawable/aether_search" android:drawablePadding="4px" android:text="搜索"
            android:textSize="28px" android:textStyle="bold" android:textColor="@color/aether_text_primary"
            android:gravity="center" android:focusable="true" android:background="@drawable/ux_search_primary" />
        <TextView android:id="@+id/tvClear" android:layout_width="190px" android:layout_height="140px"
            android:layout_marginLeft="2630px" android:layout_marginTop="40px" android:text="清空"
            android:textSize="30px" android:textColor="@color/car_text_muted" android:gravity="center"
            android:focusable="true" android:background="@drawable/ux_setting_choice" />
        <FrameLayout android:layout_width="1290px" android:layout_height="1330px"
            android:layout_marginLeft="60px" android:layout_marginTop="230px" android:background="@drawable/ux_setting_card">
            <TextView android:layout_width="850px" android:layout_height="70px"
                android:layout_marginLeft="40px" android:layout_marginTop="20px"
                android:text="车载大键盘 · 简拼 / 全拼 / 首字母" android:gravity="center_vertical"
                android:textSize="28px" android:textStyle="bold" android:textColor="@color/car_text" />
            <TextView android:id="@+id/ux_search_ime" android:layout_width="350px" android:layout_height="90px"
                android:layout_marginLeft="900px" android:layout_marginTop="20px" android:text="⌨ 系统输入法"
                android:textSize="28px" android:textColor="@color/car_accent_cyan" android:gravity="center"
                android:focusable="true" android:background="@drawable/ux_setting_choice" />
            <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard android:id="@+id/keyBoardRoot"
                android:layout_width="1260px" android:layout_height="660px"
                android:layout_marginLeft="15px" android:layout_marginTop="120px" />
            <TextView android:id="@+id/tvSearchCheckboxBtn" android:layout_width="590px" android:layout_height="90px"
                android:layout_marginLeft="40px" android:layout_marginTop="805px" android:text="指定搜索源  ›"
                android:textSize="30px" android:textColor="@color/car_accent_cyan" android:gravity="center"
                android:focusable="true" android:background="@drawable/ux_setting_choice" />
            <TextView android:id="@+id/ux_search_aggregate" android:layout_width="590px" android:layout_height="90px"
                android:layout_marginLeft="660px" android:layout_marginTop="805px" android:text="全屏聚合搜索  ›"
                android:textSize="30px" android:textColor="@color/car_text" android:gravity="center"
                android:focusable="true" android:background="@drawable/ux_setting_choice" />
            <LinearLayout android:id="@+id/llWord" android:layout_width="1210px" android:layout_height="520px"
                android:layout_marginLeft="40px" android:layout_marginTop="920px" android:orientation="vertical">
                <TextView android:id="@+id/wordSwitch" android:layout_width="match_parent" android:layout_height="90px"
                    android:text="热词 | 历史" android:gravity="center_vertical" android:textSize="28px"
                    android:textStyle="bold" android:textColor="@color/car_text" android:focusable="true" />
                <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewWord"
                    android:layout_width="match_parent" android:layout_height="420px" android:clipToPadding="false"
                    app:tv_verticalSpacingWithMargins="12px" app:tv_horizontalSpacingWithMargins="12px" />
            </LinearLayout>
            <LinearLayout android:id="@+id/remoteRoot" android:layout_width="1210px" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvAddress" android:layout_width="match_parent" android:layout_height="80px"
                    android:textSize="28px" android:textColor="@color/car_text" />
                <ImageView android:id="@+id/ivQRCode" android:layout_width="300px" android:layout_height="300px"
                    android:contentDescription="远程输入二维码" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="1420px" android:layout_height="1330px"
            android:layout_marginLeft="1400px" android:layout_marginTop="230px" android:background="@drawable/ux_setting_card">
            <LinearLayout android:id="@+id/llHistoryWord" android:layout_width="1340px" android:layout_height="190px"
                android:layout_marginLeft="40px" android:layout_marginTop="10px" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="90px">
                    <TextView android:id="@+id/tvHistoryTitle" android:layout_width="1000px" android:layout_height="match_parent"
                        android:text="最近搜索" android:gravity="center_vertical" android:textSize="28px"
                        android:textStyle="bold" android:textColor="@color/car_text" />
                    <ImageView android:id="@+id/tvHistoryClear" android:layout_width="90px" android:layout_height="90px"
                        android:layout_gravity="right" android:padding="15px" android:src="@drawable/icon_delete"
                        android:contentDescription="清空搜索历史" android:focusable="true" android:background="@drawable/ux_setting_choice" />
                </FrameLayout>
                <ScrollView android:layout_width="match_parent" android:layout_height="95px" android:fillViewport="true">
                    <GridLayout android:id="@+id/historyWordGrid" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:columnCount="1" />
                </ScrollView>
            </LinearLayout>
            <TextView android:id="@+id/ux_search_result_title" android:layout_width="1340px" android:layout_height="40px"
                android:layout_marginLeft="40px" android:layout_marginTop="195px" android:text="多源搜索结果"
                android:textSize="26px" android:textColor="@color/car_text_muted" />
            <LinearLayout android:id="@+id/llLayout" android:layout_width="1340px" android:layout_height="1100px"
                android:layout_marginLeft="40px" android:layout_marginTop="230px" android:orientation="vertical">
                <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView"
                    android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="invisible"
                    android:clipToPadding="false" app:tv_verticalSpacingWithMargins="25px" />
            </LinearLayout>
            <LinearLayout android:id="@+id/uxSearchEmpty" android:layout_width="1340px" android:layout_height="560px"
                android:layout_marginLeft="40px" android:layout_marginTop="430px" android:background="@drawable/car_surface_card_raised"
                android:gravity="center" android:orientation="vertical" android:visibility="gone">
                <ImageView android:layout_width="96px" android:layout_height="96px" android:src="@drawable/aether_search"
                    android:contentDescription="" android:alpha="0.7" />
                <TextView android:layout_width="match_parent" android:layout_height="70px" android:layout_marginTop="20px"
                    android:gravity="center" android:text="暂无匹配结果" android:textColor="@color/car_text"
                    android:textSize="38px" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="60px" android:gravity="center"
                    android:text="试试完整片名或首字母简拼" android:textColor="@color/car_text_muted" android:textSize="28px" />
                <TextView android:id="@+id/uxSearchEmptyClear" android:layout_width="300px" android:layout_height="88px"
                    android:layout_marginTop="24px" android:background="@drawable/car_button_selector" android:clickable="true"
                    android:focusable="true" android:gravity="center" android:text="清空搜索" android:textColor="@color/car_text"
                    android:textSize="28px" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
