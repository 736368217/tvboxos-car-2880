<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/car_surface"
    android:paddingTop="@dimen/car_top_padding"
    android:paddingBottom="@dimen/car_bottom_padding"
    android:paddingLeft="@dimen/car_side_padding"
    android:paddingRight="@dimen/car_side_padding">

    <TextView android:id="@+id/uxPageBack" style="@style/UxSceneButton" android:layout_width="180px" android:layout_height="96px" android:layout_marginLeft="60px" android:layout_marginTop="40px" android:drawableLeft="@drawable/ic_tvbox_action_back" android:drawablePadding="10px" android:text="返回" android:textColor="@color/aether_cyan_focus" android:textSize="28px" android:contentDescription="返回上一页" />
    <TextView android:layout_width="1800px" android:layout_height="88px" android:layout_marginLeft="280px" android:layout_marginTop="40px" android:gravity="center_vertical" android:drawableLeft="@drawable/ic_tvbox_nav_push" android:drawablePadding="14px" android:text="多端互联 · AirPush" android:textColor="@color/aether_text_primary" android:textSize="38px" android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_300"
            android:layout_height="@dimen/vs_300"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvAddress" android:drawableLeft="@drawable/ic_tvbox_file_qr" android:drawablePadding="10px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:textAlignment="gravity"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            tools:text="1111111111111111111111111111111111111111111111111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="70px"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="center"
            android:text="1. 手机扫码打开投送页  2. 粘贴视频链接  3. 车机立即开播"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />
        <TextView
            android:id="@+id/pushLocal" android:drawableLeft="@drawable/ic_tvbox_action_copy" android:drawablePadding="10px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_10"
            android:text="推送剪贴板内容"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</FrameLayout>