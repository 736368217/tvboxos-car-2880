<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/uxHomeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/car_bg">
    <FrameLayout android:layout_width="2880px" android:layout_height="1620px" android:background="@drawable/car_surface">
        <LinearLayout android:id="@+id/contentLayout" android:layout_width="2880px" android:layout_height="1470px" android:layout_marginTop="150px" android:orientation="vertical">
            <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager android:id="@+id/mViewPager" android:layout_width="match_parent" android:layout_height="match_parent" />
        </LinearLayout>
        <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView" android:layout_width="2520px" android:layout_height="100px" android:layout_marginLeft="304px" android:layout_marginTop="710px" android:clipToPadding="true" android:background="@color/aether_bg_obsidian_950" app:tv_horizontalSpacingWithMargins="20px" app:tv_selectedItemIsCentered="false" />
        <FrameLayout android:layout_width="256px" android:layout_height="match_parent" android:background="@color/aether_bg_obsidian_900">
            <ImageView android:id="@+id/aetherBrandLogo" android:layout_width="64px" android:layout_height="64px" android:layout_marginLeft="48px" android:layout_marginTop="36px" android:contentDescription="TVBOX 3K" android:src="@drawable/ic_tvbox_brand_orbit" />
            <TextView style="@style/UxSceneText" android:layout_width="160px" android:layout_height="40px" android:layout_marginLeft="48px" android:layout_marginTop="108px" android:text="TVBOX" android:textColor="@color/aether_text_primary" android:textSize="26px" android:textStyle="bold" />
            <TextView style="@style/UxSceneText" android:layout_width="180px" android:layout_height="30px" android:layout_marginLeft="48px" android:layout_marginTop="152px" android:text="3K · CAR EDITION" android:textColor="@color/aether_text_muted" android:textSize="18px" />
            <LinearLayout android:layout_width="208px" android:layout_height="wrap_content" android:layout_marginLeft="24px" android:layout_marginTop="216px" android:orientation="vertical">
                <LinearLayout android:id="@+id/uxNavHome" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_recommend_selector"/><TextView style="@style/UxSceneNavText" android:text="精选推荐"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavCategories" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_categories_selector"/><TextView style="@style/UxSceneNavText" android:text="分类专题"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavLive" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_live_selector"/><TextView style="@style/UxSceneNavText" android:text="电视直播"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavHistory" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_history_selector"/><TextView style="@style/UxSceneNavText" android:text="播放历史"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavCollect" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_favorites_selector"/><TextView style="@style/UxSceneNavText" android:text="我的收藏"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavPush" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_push_selector"/><TextView style="@style/UxSceneNavText" android:text="多端推送"/></LinearLayout>
                <LinearLayout android:id="@+id/uxNavSettings" style="@style/UxSceneNav"><ImageView style="@style/UxSceneNavIcon" android:src="@drawable/ic_tvbox_nav_settings_selector"/><TextView style="@style/UxSceneNavText" android:text="系统设置"/></LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/uxEngineStatus" style="@style/UxSceneText" android:layout_width="208px" android:layout_height="56px" android:layout_marginLeft="24px" android:layout_marginTop="1494px" android:background="@null" android:gravity="center_vertical" android:paddingLeft="8px" android:text="●  播放器就绪" android:textColor="@color/car_state_success" android:textSize="20px" />
        </FrameLayout>
        <LinearLayout android:id="@+id/topLayout" android:layout_width="2520px" android:layout_height="90px" android:layout_marginLeft="304px" android:layout_marginTop="40px" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvName" style="@style/UxSceneButton" android:layout_width="260px" android:layout_height="90px" android:background="@drawable/car_surface_card" android:text="TVBox · 选择源站" android:textColor="@color/aether_cyan_focus" android:textSize="24px" android:maxLines="1" />
            <TextView android:id="@+id/uxHomeSearch" style="@style/UxSceneButton" android:layout_width="1760px" android:layout_height="90px" android:layout_marginLeft="20px" android:background="@drawable/ux_search_outline" android:gravity="center_vertical" android:paddingLeft="30px" android:drawableLeft="@drawable/ic_tvbox_action_search" android:drawablePadding="20px" android:text="搜索片名 / 首字母简拼" android:textColor="@color/car_text_dim" android:textSize="26px" />
            <TextView android:id="@+id/tvDate" style="@style/UxSceneText" android:layout_width="460px" android:layout_height="90px" android:layout_marginLeft="20px" android:background="@drawable/car_surface_card" android:gravity="center" android:textColor="@color/car_text_dim" android:textSize="24px" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
