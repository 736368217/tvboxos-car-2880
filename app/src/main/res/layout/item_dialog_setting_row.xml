<?xml version="1.0" encoding="utf-8"?>
<!-- 设置类弹窗的一行：左边名称，右边当前值，行背景与设置页一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_60"
    android:layout_marginTop="@dimen/vs_8"
    android:background="@drawable/shape_setting_model_focus"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_20"
    android:paddingRight="@dimen/vs_20">

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_12"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />
</LinearLayout>
