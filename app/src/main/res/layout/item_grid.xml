<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian grid card. IDs / hierarchy are contract-bound to GridAdapter, CollectAdapter,
     HistoryAdapter (ivThumb, tvYear, tvArea, tvLang, tvNote, tvName, tvActor, delFrameLayout, imageView).
     Visual only: card surface + cyan focus ring (foreground) + badge/scrim hierarchy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/car_surface_card_selector"
    android:clipChildren="false"
    android:focusable="true"
    android:foreground="@drawable/car_outline_focus"
    android:padding="@dimen/car_gap_card">

    <FrameLayout
        android:layout_width="@dimen/vs_214"
        android:layout_height="@dimen/vs_280"
        android:background="@drawable/car_poster_surface"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/vs_1"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_6"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_marginRight="@dimen/vs_6"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvYear"
                style="@style/CarPosterBadge"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:background="@drawable/car_badge_blue" />

            <TextView
                android:id="@+id/tvArea"
                style="@style/CarPosterBadge"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:background="@drawable/car_badge_amber" />

            <TextView
                android:id="@+id/tvLang"
                style="@style/CarPosterBadge"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:background="@drawable/car_badge_green" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/vs_1">

            <TextView
                android:id="@+id/tvNote"
                style="@style/CarPosterBadge"
                android:layout_gravity="bottom"
                android:layout_marginLeft="@dimen/vs_6"
                android:layout_marginRight="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_5"
                android:background="@drawable/car_badge_dark" />

            <TextView
                android:id="@+id/tvName"
                style="@style/CarGridItemTitle"
                android:background="@drawable/car_badge_scrim"
                android:ellipsize="end"
                android:text="Title" />

            <TextView
                android:id="@+id/tvActor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/car_badge_scrim"
                android:ellipsize="end"
                android:gravity="top"
                android:maxLines="1"
                android:padding="@dimen/vs_5"
                android:singleLine="true"
                android:textColor="@color/car_text_dim"
                android:textSize="@dimen/ts_18"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/shape_user_delete"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vs_20"
                android:src="@drawable/icon_delete" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
