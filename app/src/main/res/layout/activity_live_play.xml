<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg">

    <FrameLayout
        android:id="@+id/live_root"
        android:layout_width="2880px"
        android:layout_height="1620px"
        android:background="@color/car_bg">

        <!-- All coordinates below are native design pixels; CarSceneLayout scales the scene. -->
        <FrameLayout
            android:id="@+id/ux_live_chrome"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="1680px"
                android:layout_height="1400px"
                android:layout_marginLeft="1140px"
                android:layout_marginTop="160px"
                android:background="@drawable/car_surface_card" />

            <TextView
                android:id="@+id/ux_live_back"
                android:layout_width="160px"
                android:layout_height="90px"
                android:layout_marginLeft="60px"
                android:layout_marginTop="40px"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="← 返回"
                android:textColor="@color/car_text"
                android:textSize="30px"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ux_live_title"
                android:layout_width="1600px"
                android:layout_height="90px"
                android:layout_marginLeft="270px"
                android:layout_marginTop="40px"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="电视直播"
                android:textColor="@color/car_text"
                android:textSize="36px"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ux_live_favorites"
                android:layout_width="270px"
                android:layout_height="90px"
                android:layout_marginLeft="2200px"
                android:layout_marginTop="40px"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="♥ 已收藏频道"
                android:textColor="@color/car_accent"
                android:textSize="28px" />

            <TextView
                android:id="@+id/ux_live_settings"
                android:layout_width="310px"
                android:layout_height="90px"
                android:layout_marginLeft="2510px"
                android:layout_marginTop="40px"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="直播设置 / 订阅"
                android:textColor="@color/car_text"
                android:textSize="28px" />

            <TextView
                android:id="@+id/ux_live_current_channel"
                android:layout_width="1560px"
                android:layout_height="58px"
                android:layout_marginLeft="1200px"
                android:layout_marginTop="1170px"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="当前频道：未选择频道"
                android:textColor="@color/car_text"
                android:textSize="34px"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ux_live_current_epg"
                android:layout_width="1560px"
                android:layout_height="48px"
                android:layout_marginLeft="1200px"
                android:layout_marginTop="1238px"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="正在播出：暂无节目单"
                android:textColor="@color/car_accent_alt"
                android:textSize="28px" />

            <TextView
                android:id="@+id/ux_live_next_epg"
                android:layout_width="1560px"
                android:layout_height="48px"
                android:layout_marginLeft="1200px"
                android:layout_marginTop="1290px"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="接下来：暂无节目预告"
                android:textColor="@color/car_text_muted"
                android:textSize="28px" />

            <LinearLayout
                android:layout_width="1560px"
                android:layout_height="120px"
                android:layout_marginLeft="1200px"
                android:layout_marginTop="1360px"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ux_live_fullscreen"
                    android:layout_width="420px"
                    android:layout_height="match_parent"
                    android:background="@drawable/car_badge_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶ 全屏沉浸直播"
                    android:textColor="@color/car_text"
                    android:textSize="34px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ux_live_source"
                    android:layout_width="340px"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="40px"
                    android:background="@drawable/car_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="切换源"
                    android:textColor="@color/car_accent"
                    android:textSize="28px" />

                <TextView
                    android:id="@+id/ux_live_favorite"
                    android:layout_width="300px"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="40px"
                    android:background="@drawable/car_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="♡ 收藏该频道"
                    android:textColor="@color/car_text"
                    android:textSize="28px" />

                <LinearLayout
                    android:id="@+id/divLoadEpg"
                    android:layout_width="380px"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="40px"
                    android:background="@drawable/car_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:onClick="divLoadEpgRight"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tv_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="节目单 / 回看" android:textColor="@color/car_text" android:textSize="28px" />
                    <ImageView android:id="@+id/iv_arrow" android:layout_width="30px" android:layout_height="30px" android:layout_marginLeft="12px" android:src="@drawable/car_chevron_right" />
                    <TextView android:id="@+id/tv_arrow2" android:layout_width="0px" android:layout_height="0px" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- A single persistent VideoView. Fullscreen changes only its FrameLayout.LayoutParams. -->
        <xyz.doikki.videoplayer.player.VideoView
            android:id="@+id/mVideoView"
            android:layout_width="1632px"
            android:layout_height="918px"
            android:layout_marginLeft="1160px"
            android:layout_marginTop="180px"
            android:background="@android:color/black" />

        <FrameLayout
            android:id="@+id/switchChannelSnapshotOverlay"
            android:layout_width="1632px"
            android:layout_height="918px"
            android:layout_marginLeft="1160px"
            android:layout_marginTop="180px"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">
            <ImageView android:id="@+id/switchChannelSnapshotImage" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" android:scaleType="fitCenter" android:visibility="gone" />
            <ProgressBar android:layout_width="70px" android:layout_height="70px" android:layout_gravity="center" android:indeterminate="true" android:indeterminateDrawable="@drawable/anim_loading" />
        </FrameLayout>

        <TextView
            android:id="@+id/ux_live_preview_state"
            android:layout_width="320px"
            android:layout_height="65px"
            android:layout_marginLeft="1190px"
            android:layout_marginTop="210px"
            android:background="@drawable/car_badge_scrim"
            android:gravity="center"
            android:text="请选择频道"
            android:textColor="@color/car_accent"
            android:textSize="26px"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ux_live_preview_hint"
            android:layout_width="700px"
            android:layout_height="96px"
            android:layout_marginLeft="1630px"
            android:layout_marginTop="1000px"
            android:background="@drawable/car_badge_scrim"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⛶ 轻触画面，进入全屏直播"
            android:textColor="@color/car_text"
            android:textSize="28px" />

        <LinearLayout
            android:id="@+id/tvLeftChannnelListLayout"
            android:layout_width="1040px"
            android:layout_height="1400px"
            android:layout_marginLeft="60px"
            android:layout_marginTop="160px"
            android:background="@drawable/car_surface_card"
            android:orientation="vertical"
            android:paddingLeft="30px"
            android:paddingTop="30px"
            android:paddingRight="30px"
            android:paddingBottom="30px">
            <LinearLayout android:id="@+id/ll_typeSelect" android:layout_width="980px" android:layout_height="70px" android:orientation="horizontal">
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mGroupGridView"
                    android:layout_width="match_parent"
                    android:layout_height="70px"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>
            <View android:layout_width="1px" android:layout_height="30px" />
            <TextView android:id="@+id/ux_live_empty" android:layout_width="980px" android:layout_height="220px" android:gravity="center" android:text="暂无频道，请在直播设置中配置订阅" android:textColor="@color/car_text_muted" android:textSize="30px" android:visibility="gone" />
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mChannelGridView"
                android:layout_width="980px"
                android:layout_height="0px"
                android:layout_weight="1"
                android:focusable="true"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Existing EPG and catch-up adapters remain real, user-opened overlays. -->
        <LinearLayout
            android:id="@+id/divEPG"
            android:layout_width="1680px"
            android:layout_height="1400px"
            android:layout_marginLeft="1140px"
            android:layout_marginTop="160px"
            android:background="@drawable/car_surface_card_raised"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="30px"
            android:visibility="gone">
            <LinearLayout android:id="@+id/divLoadEpgleft" android:layout_width="match_parent" android:layout_height="90px" android:background="@drawable/car_button_selector" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:onClick="divLoadEpgLeft" android:orientation="horizontal">
                <TextView android:id="@+id/tv_arrow0" android:layout_width="100px" android:layout_height="match_parent" android:gravity="center" android:text="←" android:textColor="@color/car_accent" android:textSize="36px" />
                <ImageView android:id="@+id/iv_arrow2" android:layout_width="0px" android:layout_height="0px" android:visibility="gone" />
                <TextView android:id="@+id/tv_arrow3" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="节目单 / 回看 · 返回频道" android:textColor="@color/car_text" android:textSize="32px" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/divLoadEpgDivider" android:layout_width="match_parent" android:layout_height="2px" android:layout_marginTop="20px" android:background="@color/car_outline_idle" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:orientation="horizontal">
                <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mEpgDateGridView" android:layout_width="170px" android:layout_height="match_parent" android:visibility="gone" />
                <FrameLayout android:layout_width="0px" android:layout_height="match_parent" android:layout_weight="1">
                    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/lv_epg" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="20px" android:scrollbars="vertical" />
                    <TextView android:id="@+id/txtNoEpg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="暂无节目单" android:textColor="@color/car_text_muted" android:textSize="32px" android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvRightSettingLayout"
            android:layout_width="1680px"
            android:layout_height="1400px"
            android:layout_gravity="top|right"
            android:layout_marginTop="160px"
            android:layout_marginRight="60px"
            android:background="@drawable/car_surface_card_raised"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="30px"
            android:visibility="invisible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="90px" android:orientation="horizontal">
                <TextView android:layout_width="0px" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="直播设置 · 线路 / 解码 / 订阅" android:textColor="@color/car_text" android:textSize="34px" android:textStyle="bold" />
                <TextView android:id="@+id/ux_live_close_settings" android:layout_width="220px" android:layout_height="match_parent" android:background="@drawable/car_button_selector" android:clickable="true" android:focusable="true" android:gravity="center" android:text="关闭 ×" android:textColor="@color/car_accent" android:textSize="30px" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:layout_marginTop="20px" android:orientation="horizontal">
                <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mSettingItemView" android:layout_width="1100px" android:layout_height="match_parent" android:padding="20px" android:scrollbars="vertical" />
                <View android:layout_width="2px" android:layout_height="match_parent" android:background="@color/car_outline_idle" />
                <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mSettingGroupView" android:layout_width="0px" android:layout_height="match_parent" android:layout_weight="1" android:padding="20px" android:scrollbars="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fullscreen-only transient channel/EPG information, preserving original IDs and types. -->
        <RelativeLayout android:id="@+id/ll_epg" android:layout_width="2760px" android:layout_height="230px" android:layout_gravity="bottom" android:layout_marginLeft="60px" android:layout_marginBottom="50px" android:background="@drawable/car_badge_scrim" android:visibility="gone">
            <View android:id="@+id/view_bg" android:layout_width="match_parent" android:layout_height="match_parent" />
            <LinearLayout android:id="@+id/channelinfo" android:layout_width="600px" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tv_channel_bottom_number" android:layout_width="wrap_content" android:layout_height="0px" android:visibility="gone" />
                <FrameLayout android:layout_width="300px" android:layout_height="90px">
                    <FrameLayout android:id="@+id/live_icon_null_bg" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <TextView android:id="@+id/live_icon_null_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/car_accent" android:textSize="40px" />
                    <ImageView android:id="@+id/img_live_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" />
                </FrameLayout>
                <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_channel_bar_name" android:layout_width="560px" android:layout_height="70px" android:gravity="center" android:singleLine="true" android:textColor="@color/car_text" android:textSize="34px" />
            </LinearLayout>
            <TextView android:id="@+id/tv_current_program" android:layout_width="150px" android:layout_height="80px" android:layout_toRightOf="@id/channelinfo" android:layout_marginTop="30px" android:gravity="center_vertical" android:text="正在播出" android:textColor="@color/car_text_muted" android:textSize="28px" />
            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_current_program_time" android:layout_width="250px" android:layout_height="80px" android:layout_toRightOf="@id/tv_current_program" android:layout_alignTop="@id/tv_current_program" android:gravity="center_vertical" android:singleLine="true" android:textColor="@color/car_text_muted" android:textSize="28px" />
            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_current_program_name" android:layout_width="1150px" android:layout_height="80px" android:layout_toRightOf="@id/tv_current_program_time" android:layout_alignTop="@id/tv_current_program" android:gravity="center_vertical" android:singleLine="true" android:text="暂无节目单" android:textColor="@color/car_accent_alt" android:textSize="30px" />
            <View android:id="@+id/view_line" android:layout_width="1750px" android:layout_height="1px" android:layout_toRightOf="@id/channelinfo" android:layout_below="@id/tv_current_program" android:background="@color/car_outline_idle" />
            <TextView android:id="@+id/tv_next_program" android:layout_width="150px" android:layout_height="80px" android:layout_toRightOf="@id/channelinfo" android:layout_below="@id/view_line" android:gravity="center_vertical" android:text="接下来" android:textColor="@color/car_text_muted" android:textSize="28px" />
            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_next_program_time" android:layout_width="250px" android:layout_height="80px" android:layout_toRightOf="@id/tv_next_program" android:layout_alignTop="@id/tv_next_program" android:gravity="center_vertical" android:singleLine="true" android:textColor="@color/car_text_muted" android:textSize="28px" />
            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_next_program_name" android:layout_width="1150px" android:layout_height="80px" android:layout_toRightOf="@id/tv_next_program_time" android:layout_alignTop="@id/tv_next_program" android:gravity="center_vertical" android:singleLine="true" android:text="暂无节目预告" android:textColor="@color/car_text" android:textSize="30px" />
            <RelativeLayout android:id="@+id/live_status_info" android:layout_width="500px" android:layout_height="match_parent" android:layout_alignParentRight="true">
                <TextView android:id="@+id/tv_source" android:layout_width="match_parent" android:layout_height="80px" android:layout_marginTop="30px" android:gravity="center" android:singleLine="true" android:textColor="@color/car_accent" android:textSize="28px" />
                <TextView android:id="@+id/tvResolution" android:layout_width="match_parent" android:layout_height="80px" android:layout_below="@id/tv_source" android:gravity="center" android:textColor="@color/car_text" android:textSize="28px" android:visibility="gone" />
            </RelativeLayout>
        </RelativeLayout>

        <TextView android:id="@+id/tvChannel" android:layout_width="wrap_content" android:layout_height="80px" android:layout_gravity="top|right" android:layout_marginTop="40px" android:layout_marginRight="60px" android:background="@drawable/car_badge_scrim" android:gravity="center" android:paddingLeft="24px" android:paddingRight="24px" android:textColor="@color/car_text" android:textSize="34px" android:visibility="gone" />
        <LinearLayout android:id="@+id/tv_top_status" android:layout_width="wrap_content" android:layout_height="70px" android:layout_gravity="top|right" android:layout_marginTop="90px" android:layout_marginRight="100px" android:background="@drawable/car_badge_scrim" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="20px" android:paddingRight="20px" android:visibility="gone">
            <TextView android:id="@+id/tvNetSpeed" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginRight="24px" android:gravity="center" android:textColor="@color/car_text" android:textSize="26px" android:visibility="gone" />
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/car_text" android:textSize="26px" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/tv_selected_channel" android:layout_width="250px" android:layout_height="150px" android:layout_gravity="top|right" android:layout_marginTop="180px" android:layout_marginRight="80px" android:gravity="center" android:textColor="@color/car_accent" android:textSize="64px" android:textStyle="bold" android:visibility="invisible" />
        <TextView android:id="@+id/tv_shownum" android:layout_width="0px" android:layout_height="0px" />
        <TextView android:id="@+id/tv_showTime" android:layout_width="0px" android:layout_height="0px" />
        <LinearLayout android:id="@+id/ll_loading" android:layout_width="0px" android:layout_height="0px" android:orientation="vertical" />
        <RelativeLayout android:id="@+id/ll_right_top_huikan" android:layout_width="640px" android:layout_height="90px" android:layout_gravity="top|right" android:layout_marginRight="100px" android:layout_marginTop="180px" android:background="@drawable/car_badge_scrim" android:visibility="gone">
            <ImageView android:id="@+id/iv_back_bg" android:layout_width="70px" android:layout_height="70px" android:layout_centerVertical="true" android:src="@drawable/app_icon" />
            <TextView android:id="@+id/tv_right_top_epg_name" android:layout_width="400px" android:layout_height="match_parent" android:layout_toRightOf="@id/iv_back_bg" android:gravity="center_vertical" android:singleLine="true" android:textColor="@color/car_text" android:textSize="28px" />
            <TextView android:id="@+id/tv_right_top_type" android:layout_width="160px" android:layout_height="match_parent" android:layout_alignParentRight="true" android:gravity="center" android:text="回看中" android:textColor="@color/car_accent_alt" android:textSize="26px" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/ll_right_top_loading" android:layout_width="640px" android:layout_height="90px" android:layout_gravity="top|right" android:layout_marginRight="100px" android:layout_marginTop="180px" android:background="@drawable/car_badge_scrim" android:visibility="gone">
            <ImageView android:id="@+id/iv_circle_bg" android:layout_width="70px" android:layout_height="70px" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:src="@drawable/app_icon" />
            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView android:id="@+id/tv_right_top_channel_name" android:layout_width="550px" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:textColor="@color/car_text" android:textSize="28px" />
        </RelativeLayout>

        <RelativeLayout android:id="@+id/backcontroller" android:layout_width="2760px" android:layout_height="130px" android:layout_gravity="bottom" android:layout_marginLeft="60px" android:layout_marginBottom="60px" android:background="@drawable/car_badge_scrim" android:visibility="gone">
            <LinearLayout android:id="@+id/ll_play" android:layout_width="120px" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                <ImageView android:id="@+id/iv_play" android:layout_width="90px" android:layout_height="90px" android:background="@drawable/icon_play" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/progress_container" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="30px" android:paddingRight="30px">
                <ImageView android:id="@+id/iv_playpause" android:layout_width="100px" android:layout_height="100px" android:background="@drawable/vod_pause" android:contentDescription="播放或暂停回看" android:focusable="true" />
                <TextView android:id="@+id/tv_currentpos" android:layout_width="200px" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:text="@string/_00_00_00" android:textColor="@color/car_text" android:textSize="28px" />
                <SeekBar android:id="@+id/pb_progressbar" android:layout_width="0px" android:layout_height="100px" android:layout_weight="1" android:focusable="true" android:max="100" android:progress="0" android:progressDrawable="@drawable/shape_player_control_vod_seek" android:thumb="@drawable/shape_player_control_vod_seek_thumb" />
                <TextView android:id="@+id/tv_duration" android:layout_width="200px" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:text="@string/_00_00_00" android:textColor="@color/car_text" android:textSize="28px" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
