<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/car_top_padding"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/car_bottom_padding" android:background="@drawable/car_surface">

    <TextView android:id="@+id/uxPageBack" style="@style/UxSceneButton" android:layout_width="180px" android:layout_height="96px" android:drawableLeft="@drawable/aether_back" android:drawablePadding="10px" android:text="返回" android:textColor="@color/aether_cyan_focus" android:textSize="28px" android:contentDescription="返回上一页" />
    <TextView android:layout_width="1800px" android:layout_height="88px" android:layout_marginLeft="220px" android:gravity="center_vertical" android:text="本地文件 / 配置与媒体" android:textColor="@color/aether_text_primary" android:textSize="38px" android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_30" />

        <TextView
            android:id="@+id/tvPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_20" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:paddingBottom="@dimen/vs_10"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:text="当前目录为空"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_22"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
