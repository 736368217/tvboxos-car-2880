<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/car_top_padding"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/car_bottom_padding" android:background="@drawable/car_surface">

    <TextView android:id="@+id/uxPageBack" style="@style/UxSceneButton" android:layout_width="180px" android:layout_height="96px" android:drawableLeft="@drawable/ic_tvbox_action_back" android:drawablePadding="10px" android:text="返回" android:textColor="@color/aether_cyan_focus" android:textSize="28px" android:contentDescription="返回上一页" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle" android:drawableLeft="@drawable/ic_tvbox_file_folder" android:drawablePadding="12px"
            android:layout_width="match_parent"
            android:layout_height="88px"
            android:layout_marginLeft="220px"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_30" />
        <TextView
            android:id="@+id/tvPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_20" />


        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/fileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:paddingBottom="@dimen/vs_10"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty" android:drawableLeft="@drawable/ic_tvbox_file_empty" android:drawablePadding="12px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:text="当前文件夹为空，可将配置或媒体文件放入 TVBox 文件夹"
            android:textColor="@color/color_CCFFFFFF"
            android:textSize="@dimen/ts_22"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
