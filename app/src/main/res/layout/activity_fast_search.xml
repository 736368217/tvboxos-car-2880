<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/car_surface"
    android:tag="2880,1620">
    <FrameLayout android:layout_width="2880px" android:layout_height="1620px">
        <com.github.tvbox.osc.car.CarIconTextView android:id="@+id/uxFastSearchBack" android:drawableLeft="@drawable/ic_tvbox_action_back" android:drawablePadding="8px" android:layout_width="180px" android:layout_height="96px"
            android:layout_marginLeft="60px" android:layout_marginTop="40px" android:background="@drawable/ux_setting_choice"
            android:clickable="true" android:contentDescription="返回上一页" android:focusable="true" android:gravity="center"
            android:text="返回" android:textColor="@color/aether_cyan_focus" android:textSize="28px" />
        <com.github.tvbox.osc.car.CarIconTextView android:layout_width="1100px" android:layout_height="90px" android:layout_marginLeft="280px"
            android:layout_marginTop="40px" android:gravity="center_vertical" android:drawableLeft="@drawable/ic_tvbox_content_quick_search" android:drawablePadding="12px" android:text="全屏聚合搜索"
            android:textColor="@color/aether_text_primary" android:textSize="38px" android:textStyle="bold" />
        <TextView android:id="@+id/uxFastSearchQuery" android:layout_width="980px" android:layout_height="90px"
            android:layout_marginLeft="1400px" android:layout_marginTop="40px" android:ellipsize="end"
            android:gravity="center_vertical|right" android:maxLines="1" android:textColor="@color/car_accent_cyan"
            android:textSize="30px" />
        <FrameLayout android:layout_width="500px" android:layout_height="1380px" android:layout_marginLeft="60px"
            android:layout_marginTop="160px" android:background="@drawable/ux_setting_card">
            <TextView android:layout_width="440px" android:layout_height="70px" android:layout_marginLeft="30px"
                android:layout_marginTop="20px" android:gravity="center_vertical" android:text="搜索来源"
                android:textColor="@color/car_text" android:textSize="30px" android:textStyle="bold" />
            <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewWord" android:layout_width="460px"
                android:layout_height="1250px" android:layout_marginLeft="20px" android:layout_marginTop="100px"
                android:clipChildren="false" android:clipToPadding="false" android:focusable="true"
                android:paddingBottom="70px" android:scrollbars="vertical"
                app:tv_horizontalSpacingWithMargins="8px" app:tv_verticalSpacingWithMargins="12px" />
        </FrameLayout>
        <FrameLayout android:layout_width="2200px" android:layout_height="1380px" android:layout_marginLeft="620px"
            android:layout_marginTop="160px" android:background="@drawable/ux_setting_card">
            <TextView android:id="@+id/mSearchTitle" android:layout_width="560px" android:layout_height="86px"
                android:layout_marginLeft="32px" android:layout_marginTop="20px" android:background="@drawable/car_surface_card"
                android:gravity="center" android:includeFontPadding="false" android:lines="2" android:maxLines="2"
                android:text="准备搜索&#10;输入片名聚合检索" android:textColor="@color/car_text" android:textSize="28px" />
            <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewWordFenci" android:layout_width="1540px"
                android:layout_height="86px" android:layout_marginLeft="640px" android:layout_marginTop="20px"
                android:clipChildren="false" android:clipToPadding="false" android:focusable="false"
                app:tv_horizontalSpacingWithMargins="10px" />
            <LinearLayout android:id="@+id/llLayout" android:layout_width="2140px" android:layout_height="1160px"
                android:layout_marginLeft="30px" android:layout_marginTop="125px" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false"
                        android:clipToPadding="false" android:paddingTop="20px" android:paddingBottom="80px"
                        android:visibility="invisible" app:tv_horizontalSpacingWithMargins="20px"
                        app:tv_verticalSpacingWithMargins="20px" />
                    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewFilter"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false"
                        android:clipToPadding="false" android:paddingTop="20px" android:paddingBottom="80px"
                        android:visibility="invisible" app:tv_horizontalSpacingWithMargins="20px"
                        app:tv_verticalSpacingWithMargins="20px" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/uxFastSearchEmpty" android:layout_width="2140px" android:layout_height="1160px"
                android:layout_marginLeft="30px" android:layout_marginTop="125px" android:background="@drawable/car_surface_card_raised"
                android:gravity="center" android:orientation="vertical" android:visibility="gone">
                <ImageView android:layout_width="100px" android:layout_height="100px" android:alpha="0.7"
                    android:contentDescription="" android:src="@drawable/ic_tvbox_action_search" />
                <TextView android:id="@+id/uxFastSearchEmptyTitle" android:layout_width="match_parent" android:layout_height="80px" android:layout_marginTop="22px"
                    android:gravity="center" android:text="暂无匹配内容" android:textColor="@color/car_text"
                    android:textSize="40px" android:textStyle="bold" />
                <TextView android:id="@+id/uxFastSearchEmptyMessage" android:layout_width="match_parent" android:layout_height="70px" android:gravity="center"
                    android:text="检查订阅源，或尝试完整片名和简拼" android:textColor="@color/car_text_muted" android:textSize="30px" />
                <TextView android:id="@+id/uxFastSearchBackToEdit" android:layout_width="360px" android:layout_height="96px"
                    android:layout_marginTop="28px" android:background="@drawable/car_button_selector" android:clickable="true"
                    android:focusable="true" android:gravity="center" android:text="返回修改关键词"
                    android:textColor="@color/car_text" android:textSize="28px" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
