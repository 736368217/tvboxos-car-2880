  <LinearLayout android:layout_width="1580px" android:layout_height="match_parent" android:layout_marginLeft="40px" android:orientation="vertical">
   <TextView android:id="@+id/tv_info_name1" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="65px" android:textSize="36px" android:textStyle="bold" android:maxLines="1"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="60px" android:orientation="horizontal">
    <TextView android:id="@+id/tv_videosize" style="@style/UxSceneText" android:layout_height="60px" android:background="@drawable/car_badge_dark" android:gravity="center" android:padding="10px" android:tag="vod_video_size" android:textSize="24px"/>
    <TextView android:id="@+id/tv_framerate" style="@style/UxSceneText" android:layout_height="60px" android:layout_marginLeft="20px" android:background="@drawable/car_badge_dark" android:gravity="center" android:padding="10px" android:text="帧率 --" android:textColor="@color/car_accent_cyan" android:textSize="24px"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/tv_top_r_container" android:layout_width="920px" android:layout_height="150px" android:layout_marginLeft="1900px" android:layout_marginTop="40px" android:orientation="vertical" android:gravity="end" android:tag="tv_top_container" android:visibility="gone">
  <LinearLayout android:id="@+id/tv_screen_display" android:layout_width="wrap_content" android:layout_height="90px" android:gravity="center_vertical">
