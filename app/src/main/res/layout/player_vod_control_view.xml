   <TextView android:id="@+id/play_car_audio" style="@style/UxSceneButton" android:layout_width="360px" android:layout_height="190px" android:layout_marginLeft="30px" android:text="座舱音效" android:textSize="30px" android:textColor="@color/car_accent_amber"/>
   <Space android:layout_width="0px" android:layout_height="1px" android:layout_weight="1"/>
   <TextView android:id="@+id/play_speed" style="@style/UxSceneButton" android:layout_width="170px" android:layout_height="150px" android:layout_marginLeft="20px" android:text="1.0x" android:textSize="28px"/>
   <TextView android:id="@+id/uxEpisodes" style="@style/UxSceneButton" android:layout_width="170px" android:layout_height="150px" android:layout_marginLeft="20px" android:text="选集" android:textSize="28px"/>
   <TextView android:id="@+id/play_scale" style="@style/UxSceneButton" android:layout_width="170px" android:layout_height="150px" android:layout_marginLeft="20px" android:text="16:9" android:textSize="28px"/>
