<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="2880px"
        android:layout_height="1620px">

        <!-- Cinematic scrims keep the controls readable without boxing in the video. -->
        <View
            android:id="@+id/player_top_scrim"
            android:layout_width="match_parent"
            android:layout_height="360px"
            android:background="@drawable/car_player_top_scrim"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <View
            android:id="@+id/player_bottom_scrim"
            android:layout_width="match_parent"
            android:layout_height="640px"
            android:layout_gravity="bottom"
            android:background="@drawable/car_player_bottom_scrim"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Title block. The back affordance is a separate always-reachable layer below. -->
        <LinearLayout
            android:id="@+id/tv_top_l_container"
            android:layout_width="1980px"
            android:layout_height="132px"
            android:layout_marginLeft="176px"
            android:layout_marginTop="50px"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:tag="tv_top_container"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_info_name1"
                style="@style/UxSceneText"
                android:layout_width="match_parent"
                android:layout_height="72px"
                android:maxLines="1"
                android:textSize="40px"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_videosize"
                    style="@style/UxSceneText"
                    android:layout_width="wrap_content"
                    android:layout_height="46px"
                    android:background="@drawable/car_badge_dark"
                    android:gravity="center"
                    android:paddingLeft="18px"
                    android:paddingRight="18px"
                    android:tag="vod_video_size"
                    android:textSize="22px" />

                <TextView
                    android:id="@+id/tv_framerate"
                    style="@style/UxSceneText"
                    android:layout_width="wrap_content"
                    android:layout_height="46px"
                    android:layout_marginLeft="14px"
                    android:background="@drawable/car_badge_dark"
                    android:gravity="center"
                    android:paddingLeft="18px"
                    android:paddingRight="18px"
                    android:tag="vod_video_framerate"
                    android:text="片源 -- fps · 输出 -- fps"
                    android:textColor="@color/car_accent_cyan"
                    android:textSize="22px"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Optional playback telemetry and a single lock action. -->
        <LinearLayout
            android:id="@+id/tv_top_r_container"
            android:layout_width="620px"
            android:layout_height="96px"
            android:layout_marginLeft="2204px"
            android:layout_marginTop="50px"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:tag="tv_top_container"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tv_screen_display"
                android:layout_width="wrap_content"
                android:layout_height="96px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/net_play_speed"
                    style="@style/UxSceneText"
                    android:layout_width="wrap_content"
                    android:layout_height="64px"
                    android:gravity="center"
                    android:tag="vod_control_pause_time"
                    android:textColor="@color/car_text_dim"
                    android:textSize="22px"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_seek_time"
                    style="@style/UxSceneText"
                    android:layout_width="wrap_content"
                    android:layout_height="64px"
                    android:layout_marginLeft="16px"
                    android:gravity="center"
                    android:tag="vod_control_pause_time"
                    android:textSize="22px"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_play_load_net_speed_right_top"
                    style="@style/UxSceneText"
                    android:layout_width="1px"
                    android:layout_height="1px"
                    android:tag="vod_control_pause_time"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_sys_time"
                    style="@style/UxSceneText"
                    android:layout_width="120px"
                    android:layout_height="64px"
                    android:layout_marginLeft="16px"
                    android:gravity="center"
                    android:tag="vod_control_pause_time"
                    android:textSize="24px"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tv_lock"
                android:layout_width="90px"
                android:layout_height="90px"
                android:layout_marginLeft="18px"
                android:background="@drawable/car_player_round_icon_selector"
                android:clickable="true"
                android:contentDescription="锁屏防触"
                android:focusable="true"
                android:padding="20px"
                android:src="@drawable/ic_tvbox_player_lock" />
        </LinearLayout>

        <com.github.tvbox.osc.subtitle.widget.SimpleSubtitleView
            android:id="@+id/subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:padding="30px"
            android:textColor="#FFFFFF"
            android:textSize="40px" />

        <com.google.android.exoplayer2.ui.SubtitleView
            android:id="@+id/exo_subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.github.tvbox.osc.subtitle.widget.SimpleSubtitleView
            android:id="@+id/lyric_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="40px"
            android:visibility="gone" />

        <!-- Primary transport dock. Only high-frequency actions live here. -->
        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="2760px"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="60px"
            android:layout_marginBottom="52px"
            android:background="@drawable/car_player_dock_bg"
            android:orientation="vertical"
            android:paddingLeft="36px"
            android:paddingTop="24px"
            android:paddingRight="36px"
            android:paddingBottom="24px"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/curr_time"
                    style="@style/UxSceneText"
                    android:layout_width="150px"
                    android:layout_height="70px"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/car_text_regular"
                    android:textSize="26px" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0px"
                    android:layout_height="72px"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:max="1000"
                    android:maxHeight="16px"
                    android:minHeight="12px"
                    android:nextFocusLeft="@id/seekBar"
                    android:nextFocusRight="@id/seekBar"
                    android:progressDrawable="@drawable/car_player_seek"
                    android:splitTrack="false"
                    android:thumb="@drawable/shape_player_control_vod_seek_thumb" />

                <TextView
                    android:id="@+id/total_time"
                    style="@style/UxSceneText"
                    android:layout_width="150px"
                    android:layout_height="70px"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/car_text_regular"
                    android:textSize="26px" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="8px"
                android:layout_marginBottom="8px"
                android:background="#266FF2C6" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="136px">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/play_pre"
                        style="@style/UxPlayerButton"
                        android:layout_width="150px"
                        android:layout_height="108px"
                        android:contentDescription="上一集"
                        android:drawableLeft="@drawable/ic_tvbox_player_prev"
                        android:text="上一集" />

                    <TextView
                        android:id="@+id/uxRewind"
                        style="@style/UxPlayerButton"
                        android:layout_width="214px"
                        android:layout_height="108px"
                        android:layout_marginLeft="14px"
                        android:contentDescription="后退 15 秒"
                        android:drawableLeft="@drawable/ic_tvbox_player_replay15"
                        android:text="后退 15 秒" />

                    <TextView
                        android:id="@+id/uxPlayPause"
                        style="@style/UxPlayerPrimaryButton"
                        android:layout_width="224px"
                        android:layout_height="124px"
                        android:layout_marginLeft="14px"
                        android:contentDescription="播放或暂停"
                        android:drawableLeft="@drawable/ic_tvbox_content_pause"
                        android:text="暂停" />

                    <TextView
                        android:id="@+id/uxForward"
                        style="@style/UxPlayerButton"
                        android:layout_width="214px"
                        android:layout_height="108px"
                        android:layout_marginLeft="14px"
                        android:contentDescription="前进 15 秒"
                        android:drawableLeft="@drawable/ic_tvbox_player_forward15"
                        android:text="前进 15 秒" />

                    <TextView
                        android:id="@+id/play_next"
                        style="@style/UxPlayerButton"
                        android:layout_width="150px"
                        android:layout_height="108px"
                        android:layout_marginLeft="14px"
                        android:contentDescription="下一集"
                        android:drawableLeft="@drawable/ic_tvbox_player_next"
                        android:text="下一集" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/uxEpisodes"
                        style="@style/UxPlayerButton"
                        android:layout_width="160px"
                        android:layout_height="104px"
                        android:contentDescription="选择剧集"
                        android:drawableLeft="@drawable/ic_tvbox_content_episodes"
                        android:text="选集" />

                    <TextView
                        android:id="@+id/uxMore"
                        style="@style/UxPlayerButton"
                        android:layout_width="150px"
                        android:layout_height="104px"
                        android:layout_marginLeft="12px"
                        android:contentDescription="更多播放设置"
                        android:drawableLeft="@drawable/ic_tvbox_action_more"
                        android:text="更多" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Grouped settings sheet, opened by More. -->
        <FrameLayout
            android:id="@+id/uxMoreOverlay"
            android:layout_width="match_parent"
            android:layout_height="1291px"
            android:layout_gravity="top"
            android:background="@drawable/car_player_panel_scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/uxAdvancedControls"
                android:layout_width="2440px"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="27px"
                android:background="@drawable/car_player_panel_bg"
                android:clickable="true"
                android:orientation="vertical"
                android:paddingLeft="36px"
                android:paddingTop="28px"
                android:paddingRight="36px"
                android:paddingBottom="28px">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="96px"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/play_label"
                        style="@style/UxSceneText"
                        android:layout_width="0px"
                        android:layout_height="96px"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="播放设置"
                        android:textColor="@color/car_text_strong"
                        android:textSize="34px"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/uxExpertToggle"
                        style="@style/UxPlayerOptionButton"
                        android:layout_width="190px"
                        android:layout_height="90px"
                        android:layout_marginRight="14px"
                        android:drawableLeft="@drawable/ic_tvbox_nav_settings"
                        android:text="高级"
                        android:textSize="22px" />

                    <ImageView
                        android:id="@+id/uxMoreClose"
                        android:layout_width="90px"
                        android:layout_height="90px"
                        android:background="@drawable/car_player_round_icon_selector"
                        android:clickable="true"
                        android:contentDescription="关闭播放设置"
                        android:focusable="true"
                        android:padding="22px"
                        android:src="@drawable/ic_tvbox_action_close" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/play_btn_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UxPlayerSectionLabel"
                        android:layout_marginTop="14px"
                        android:text="画面与声音" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104px"
                        android:layout_marginTop="8px"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/play_car_video"
                            style="@style/UxPlayerOptionButton"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_picture"
                            android:text="画面 · 原画" />

                        <TextView
                            android:id="@+id/play_car_audio"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_audio"
                            android:text="音效 · 关闭" />

                        <TextView
                            android:id="@+id/play_car_sr"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_sr"
                            android:text="超分 · 关" />

                        <TextView
                            android:id="@+id/play_car_interp"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_interp"
                            android:text="补帧 · 关" />
                        <TextView
                            android:id="@+id/play_scale"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_aspect"
                            android:text="比例 · 默认" />
                    </LinearLayout>

                    <TextView
                        style="@style/UxPlayerSectionLabel"
                        android:layout_marginTop="16px"
                        android:text="播放与字幕" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104px"
                        android:layout_marginTop="8px"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/play_speed"
                            style="@style/UxPlayerOptionButton"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_speed"
                            android:text="倍速 · 1.0x" />

                        <TextView
                            android:id="@+id/uxChangeSource"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_content_swap"
                            android:text="换源" />

                        <TextView
                            android:id="@+id/zimu_select"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_subtitle"
                            android:text="字幕" />

                        <TextView
                            android:id="@+id/audio_track_select"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_audio_track"
                            android:text="音轨" />

                        <TextView
                            android:id="@+id/video_track_select"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_video_track"
                            android:text="视轨" />
                    </LinearLayout>

                    <TextView
                        style="@style/UxPlayerSectionLabel"
                        android:layout_marginTop="16px"
                        android:text="弹幕与工具" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104px"
                        android:layout_marginTop="8px"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/danmu_setting"
                            style="@style/UxPlayerOptionButton"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_danmaku"
                            android:text="弹幕" />

                        <TextView
                            android:id="@+id/danmu_search_ui"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_content_quick_search"
                            android:text="搜弹幕" />

                        <TextView
                            android:id="@+id/uxBackgroundPlayback"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_player_bg_audio"
                            android:text="后台播放 · 关" />

                        <TextView
                            android:id="@+id/screen_display"
                            style="@style/UxPlayerOptionButton"
                            android:layout_marginLeft="14px"
                            android:layout_weight="1"
                            android:drawableLeft="@drawable/ic_tvbox_settings_display"
                            android:text="屏显 · 关" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/uxExpertControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/UxPlayerSectionLabel"
                            android:layout_marginTop="16px"
                            android:text="高级播放设置" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="96px"
                            android:layout_marginTop="8px"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/play_player"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_player_decoder"
                                android:text="播放器" />

                            <TextView
                                android:id="@+id/play_ijk"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_player_decoder"
                                android:text="解码" />

                            <TextView
                                android:id="@+id/play_retry"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_action_refresh"
                                android:text="重播" />

                            <TextView
                                android:id="@+id/play_refresh"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_action_refresh"
                                android:text="刷新" />

                            <TextView
                                android:id="@+id/play_cast"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_content_cast"
                                android:text="投屏" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="96px"
                            android:layout_marginTop="12px"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/landscape_portrait"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_player_fullscreen"
                                android:text="横竖屏"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/play_time_start"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:text="片头" />

                            <TextView
                                android:id="@+id/play_time_end"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:text="片尾" />

                            <TextView
                                android:id="@+id/play_time_reset"
                                style="@style/UxPlayerOptionButton"
                                android:layout_height="96px"
                                android:layout_marginLeft="14px"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/ic_tvbox_action_refresh"
                                android:text="重置" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/play_time_start_end_text"
                            style="@style/UxSceneText"
                            android:layout_width="1px"
                            android:layout_height="1px"
                            android:text="片头尾"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/parse_root"
                        android:layout_width="match_parent"
                        android:layout_height="96px"
                        android:layout_marginTop="14px"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            style="@style/UxSceneText"
                            android:layout_width="90px"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="解析"
                            android:textColor="@color/car_text_dim"
                            android:textSize="24px" />

                        <com.owen.tvrecyclerview.widget.TvRecyclerView
                            android:id="@+id/mGridParseView"
                            android:layout_width="0px"
                            android:layout_height="96px"
                            android:layout_weight="1"
                            app:tv_horizontalSpacingWithMargins="12px" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Back is deliberately above every playback panel and stays reachable. -->
        <ImageView
            android:id="@+id/tv_back_fullscreen"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_marginLeft="56px"
            android:layout_marginTop="48px"
            android:background="@drawable/car_player_round_icon_selector"
            android:clickable="true"
            android:contentDescription="退出全屏"
            android:focusable="true"
            android:padding="24px"
            android:src="@drawable/ic_tvbox_action_back"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_marginLeft="56px"
            android:layout_marginTop="48px"
            android:background="@drawable/car_player_round_icon_selector"
            android:clickable="true"
            android:contentDescription="退出全屏"
            android:focusable="true"
            android:padding="24px"
            android:src="@drawable/ic_tvbox_action_back"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/tv_pause_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:tag="vod_control_pause"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_info_name"
                style="@style/UxSceneText"
                android:layout_width="1px"
                android:layout_height="1px"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_pause_progress_text"
                style="@style/UxSceneText"
                android:layout_gravity="center"
                android:background="@drawable/car_badge_dark"
                android:padding="30px"
                android:tag="vod_control_pause_t"
                android:textSize="42px"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_slide_progress_text"
            style="@style/UxSceneText"
            android:layout_width="400px"
            android:layout_height="200px"
            android:layout_gravity="center"
            android:background="@drawable/car_badge_dark"
            android:gravity="center"
            android:tag="vod_control_slide_info"
            android:textSize="48px"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tv_progress_container"
            android:layout_width="wrap_content"
            android:layout_height="140px"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="300px"
            android:background="@drawable/car_badge_dark"
            android:gravity="center"
            android:padding="30px"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tv_progress_icon"
                android:layout_width="60px"
                android:layout_height="60px" />

            <TextView
                android:id="@+id/tv_progress_text"
                style="@style/UxSceneText"
                android:layout_marginLeft="20px"
                android:textSize="42px" />
        </LinearLayout>

        <ProgressBar
            android:layout_width="80px"
            android:layout_height="80px"
            android:layout_gravity="center"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:tag="vod_control_loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_play_load_net_speed"
            style="@style/UxSceneText"
            android:layout_gravity="center"
            android:layout_marginTop="100px"
            android:tag="play_load_net_speed"
            android:textSize="28px" />

        <FrameLayout
            android:id="@+id/play_speed_3_container"
            android:layout_width="440px"
            android:layout_height="80px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="500px"
            android:background="@drawable/ux_search_outline"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_speed_3"
                style="@style/UxSceneText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="长按 2.0x 极速快进"
                android:textSize="28px" />
        </FrameLayout>
    </FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
