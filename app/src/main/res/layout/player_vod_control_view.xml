  </LinearLayout>
  <HorizontalScrollView android:id="@+id/uxAdvancedControls" android:layout_width="match_parent" android:layout_height="110px" android:scrollbars="none" android:visibility="gone">
   <LinearLayout android:id="@+id/play_btn_group" android:layout_width="wrap_content" android:layout_height="110px" android:gravity="center_vertical">
    <TextView android:id="@+id/play_label" style="@style/UxSceneText" android:padding="16px" android:text="播放"/>
    <TextView android:id="@+id/play_next" style="@style/UxSceneButton" android:text="下一集"/>
    <TextView android:id="@+id/play_pre" style="@style/UxSceneButton" android:text="上一集"/>
    <TextView android:id="@+id/play_retry" style="@style/UxSceneButton" android:text="重播"/>
    <TextView android:id="@+id/play_refresh" style="@style/UxSceneButton" android:text="刷新"/>
    <TextView android:id="@+id/play_player" style="@style/UxSceneButton" android:text="播放器"/>
    <TextView android:id="@+id/play_ijk" style="@style/UxSceneButton" android:text="解码"/>
    <TextView android:id="@+id/play_car_sr" style="@style/UxSceneButton" android:text="超分"/>
    <TextView android:id="@+id/play_car_interp" style="@style/UxSceneButton" android:text="补帧"/>
    <TextView android:id="@+id/play_time_start_end_text" style="@style/UxSceneText" android:text="片头尾" android:visibility="gone"/>
    <TextView android:id="@+id/play_time_start" style="@style/UxSceneButton" android:text="片头"/>
    <TextView android:id="@+id/play_time_end" style="@style/UxSceneButton" android:text="片尾"/>
    <TextView android:id="@+id/play_time_reset" style="@style/UxSceneButton" android:text="重置"/>
    <TextView android:id="@+id/play_cast" style="@style/UxSceneButton" android:text="投屏"/>
    <TextView android:id="@+id/zimu_select" style="@style/UxSceneButton" android:text="字幕"/>
    <TextView android:id="@+id/audio_track_select" style="@style/UxSceneButton" android:text="音轨" android:visibility="gone"/>
    <TextView android:id="@+id/video_track_select" style="@style/UxSceneButton" android:text="视轨" android:visibility="gone"/>
    <TextView android:id="@+id/danmu_setting" style="@style/UxSceneButton" android:text="弹幕" android:visibility="gone"/>
    <TextView android:id="@+id/danmu_search_ui" style="@style/UxSceneButton" android:text="搜弹幕" android:visibility="gone"/>
    <TextView android:id="@+id/landscape_portrait" style="@style/UxSceneButton" android:text="横竖屏" android:visibility="gone"/>
    <TextView android:id="@+id/screen_display" style="@style/UxSceneButton" android:text="屏显"/>
   </LinearLayout>
  </HorizontalScrollView>
  <LinearLayout android:id="@+id/parse_root" android:layout_width="match_parent" android:layout_height="100px" android:visibility="gone" android:gravity="center_vertical"><TextView style="@style/UxSceneText" android:text="解析"/><com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridParseView" android:layout_width="0px" android:layout_weight="1" android:layout_height="100px" app:tv_horizontalSpacingWithMargins="12px"/></LinearLayout>
 </LinearLayout>
 <FrameLayout android:id="@+id/tv_pause_container" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="vod_control_pause" android:visibility="gone" android:clickable="false">
  <TextView android:id="@+id/tv_info_name" style="@style/UxSceneText" android:layout_width="1800px" android:layout_height="90px" android:layout_marginLeft="280px" android:layout_marginTop="40px" android:textSize="36px" android:maxLines="1"/>
  <TextView android:id="@+id/tv_pause_progress_text" style="@style/UxSceneText" android:layout_gravity="center" android:background="@drawable/car_badge_dark" android:padding="30px" android:tag="vod_control_pause_t" android:textSize="42px"/>
 </FrameLayout>
 <TextView android:id="@+id/tv_slide_progress_text" style="@style/UxSceneText" android:layout_width="400px" android:layout_height="200px" android:layout_gravity="center" android:background="@drawable/car_badge_dark" android:gravity="center" android:tag="vod_control_slide_info" android:textSize="48px" android:visibility="gone"/>
 <LinearLayout android:id="@+id/tv_progress_container" android:layout_width="wrap_content" android:layout_height="140px" android:layout_gravity="top|center_horizontal" android:layout_marginTop="300px" android:background="@drawable/car_badge_dark" android:gravity="center" android:padding="30px" android:visibility="gone"><ImageView android:id="@+id/tv_progress_icon" android:layout_width="60px" android:layout_height="60px"/><TextView android:id="@+id/tv_progress_text" style="@style/UxSceneText" android:textSize="42px" android:layout_marginLeft="20px"/></LinearLayout>
 <ProgressBar android:layout_width="80px" android:layout_height="80px" android:layout_gravity="center" android:indeterminateDrawable="@drawable/anim_loading" android:tag="vod_control_loading" android:visibility="gone"/>
 <TextView android:id="@+id/tv_play_load_net_speed" style="@style/UxSceneText" android:layout_gravity="center" android:layout_marginTop="100px" android:tag="play_load_net_speed" android:textSize="28px"/>
 <FrameLayout android:id="@+id/play_speed_3_container" android:layout_width="440px" android:layout_height="80px" android:layout_gravity="center_horizontal" android:layout_marginTop="500px" android:background="@drawable/ux_search_outline" android:visibility="gone"><TextView android:id="@+id/tv_speed_3" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="match_parent" android:text="长按 2.0x 极速快进" android:textSize="28px" android:gravity="center"/></FrameLayout>
</FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
