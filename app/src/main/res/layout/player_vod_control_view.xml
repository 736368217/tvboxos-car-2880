   <TextView android:id="@+id/tv_sys_time" style="@style/UxSceneText" android:layout_width="150px" android:layout_height="80px" android:gravity="center" android:tag="vod_control_pause_time" android:textSize="28px"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="50px" android:gravity="center_vertical">
   <TextView android:id="@+id/net_play_speed" style="@style/UxSceneText" android:tag="vod_control_pause_time" android:textSize="24px"/>
   <TextView android:id="@+id/tv_seek_time" style="@style/UxSceneText" android:layout_marginLeft="20px" android:tag="vod_control_pause_time" android:textSize="24px"/>
   <TextView android:id="@+id/tv_play_load_net_speed_right_top" style="@style/UxSceneText" android:layout_marginLeft="20px" android:tag="vod_control_pause_time" android:textSize="24px" android:visibility="gone"/>
  </LinearLayout>
 </LinearLayout>
 <com.github.tvbox.osc.subtitle.widget.SimpleSubtitleView android:id="@+id/subtitle_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="30px" android:gravity="center" android:textColor="#FFFFFF" android:textSize="40px"/>
 <com.google.android.exoplayer2.ui.SubtitleView android:id="@+id/exo_subtitle_view" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
