<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootView" android:layout_width="match_parent" android:layout_height="match_parent">
<FrameLayout android:layout_width="2880px" android:layout_height="1620px">
 <LinearLayout android:id="@+id/tv_top_l_container" android:layout_width="1800px" android:layout_height="150px" android:layout_marginLeft="60px" android:layout_marginTop="40px" android:orientation="horizontal" android:gravity="center_vertical" android:tag="tv_top_container" android:visibility="gone">
