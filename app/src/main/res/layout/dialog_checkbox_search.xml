<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/vs_12"
            android:text="指定搜索源"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/checkAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="全选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:id="@+id/clearAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="全不选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_410"
            android:layout_marginTop="@dimen/vs_12"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10" />

        <TextView
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/button_danmu_setting"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_12"
            android:text="完成"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</FrameLayout>
