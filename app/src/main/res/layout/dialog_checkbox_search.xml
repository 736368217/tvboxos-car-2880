<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="@dimen/vs_420"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_pg_search_checkbox"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/uxSearchSourceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="40px"
            android:paddingTop="28px"
            android:paddingRight="40px"
            android:paddingBottom="10px">

            <TextView
                android:id="@+id/uxSearchSourceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="选择搜索源"
                android:textColor="@color/dialog_text_primary"
                android:textSize="32px"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6px"
                android:gravity="center_vertical"
                android:text="勾选参与本次搜索的站点"
                android:textColor="@color/dialog_text_hint"
                android:textSize="24px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uxSearchSourceActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="40px"
            android:paddingRight="40px"
            android:paddingBottom="10px">

            <TextView
                android:id="@+id/checkAll"
                android:layout_width="190px"
                android:layout_height="68px"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="全选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="24px" />

            <TextView
                android:id="@+id/clearAll"
                android:layout_width="190px"
                android:layout_height="68px"
                android:layout_marginLeft="14px"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="全不选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="24px" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:orientation="vertical"
            android:paddingLeft="30px"
            android:paddingTop="6px"
            android:paddingRight="30px"
            android:paddingBottom="16px"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/uxSearchSourceFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="40px"
            android:paddingRight="40px"
            android:paddingBottom="20px">

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginBottom="16px"
                android:background="@color/car_outline_idle" />

            <TextView
                android:id="@+id/uxSearchSourceClose"
                android:layout_width="190px"
                android:layout_height="76px"
                android:layout_gravity="end"
                android:background="@drawable/car_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="关闭"
                android:textColor="@color/dialog_text_primary"
                android:textSize="26px" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
