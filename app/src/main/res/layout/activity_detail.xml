<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/aether_bg_obsidian_950">
<FrameLayout android:layout_width="2880px" android:layout_height="1620px" android:background="@drawable/car_surface">
 <LinearLayout android:id="@+id/llLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <FrameLayout android:id="@+id/topLayout" android:layout_width="match_parent" android:layout_height="match_parent">
   <TextView android:id="@+id/uxDetailBack" style="@style/UxSceneButton" android:layout_width="180px" android:layout_height="96px" android:layout_marginLeft="60px" android:layout_marginTop="40px" android:drawableLeft="@drawable/ic_tvbox_action_back" android:drawablePadding="10px" android:text="返回" android:textColor="@color/aether_cyan_focus" android:textSize="28px" android:contentDescription="返回上一页"/>
   <TextView style="@style/UxSceneText" android:layout_width="2000px" android:layout_height="88px" android:layout_marginLeft="280px" android:layout_marginTop="40px" android:gravity="center_vertical" android:maxLines="1" android:text="影片详情 / 选集" android:textColor="@color/aether_text_primary" android:textSize="36px" android:textStyle="bold"/>
   <TextView style="@style/UxSceneText" android:layout_width="420px" android:layout_height="88px" android:layout_marginLeft="2400px" android:layout_marginTop="40px" android:gravity="center" android:background="@drawable/car_badge_dark" android:text="TVBOX 3K" android:textColor="@color/aether_cyan_focus" android:textSize="24px"/>
   <FrameLayout android:id="@+id/thumbContainer" android:layout_width="1360px" android:layout_height="765px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:background="@drawable/car_surface_card">
    <ImageView android:id="@+id/ivThumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <TextView android:id="@+id/tvName" style="@style/UxSceneText" android:layout_width="1280px" android:layout_height="110px" android:layout_gravity="bottom" android:layout_marginLeft="40px" android:background="@drawable/car_badge_scrim" android:gravity="center_vertical" android:paddingLeft="24px" android:ellipsize="end" android:maxLines="1" android:textColor="@color/aether_text_primary" android:textSize="40px" android:textStyle="bold"/>
    <TextView android:layout_width="260px" android:layout_height="54px" android:layout_margin="24px" android:background="@drawable/car_badge_amber" android:gravity="center" android:text="影片详情" android:textColor="@color/aether_bg_obsidian_950" android:textSize="22px" android:textStyle="bold"/>
   </FrameLayout>
   <View android:id="@+id/previewPlayerPlace" android:layout_width="1360px" android:layout_height="765px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:visibility="gone"/>
   <LinearLayout android:layout_width="1360px" android:layout_height="120px" android:layout_marginLeft="60px" android:layout_marginTop="955px" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/tvPlay" style="@style/UxSceneButton" android:layout_width="420px" android:layout_height="106px" android:drawableLeft="@drawable/ic_tvbox_content_play" android:drawablePadding="14px" android:text="全屏播放" android:textColor="@color/aether_text_primary" android:textSize="32px" android:nextFocusUp="@id/previewPlayerBlock"/>
    <TextView android:id="@+id/tvChangeSource" style="@style/UxSceneButton" android:layout_width="300px" android:layout_height="96px" android:layout_marginLeft="20px" android:drawableLeft="@drawable/ic_tvbox_content_swap" android:drawablePadding="10px" android:text="智能换源" android:textColor="@color/aether_cyan_focus" android:textSize="28px"/>
    <TextView android:id="@+id/tvCollect" style="@style/UxSceneButton" android:layout_width="240px" android:layout_height="96px" android:layout_marginLeft="20px" android:drawableLeft="@drawable/ic_tvbox_nav_favorites" android:drawablePadding="10px" android:text="加入收藏" android:textSize="26px"/>
    <TextView android:id="@+id/uxDetailCast" style="@style/UxSceneButton" android:layout_width="300px" android:layout_height="96px" android:layout_marginLeft="20px" android:drawableLeft="@drawable/ic_tvbox_content_cast" android:drawablePadding="10px" android:text="投屏 / 推送" android:textSize="26px"/>
   </LinearLayout>
   <LinearLayout android:layout_width="1360px" android:layout_height="400px" android:layout_marginLeft="60px" android:layout_marginTop="1110px" android:background="@drawable/car_surface_card" android:padding="30px" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52px" android:gravity="center_vertical"><TextView android:id="@+id/tvSite" style="@style/UxSceneText" android:maxLines="1" android:textColor="@color/aether_cyan_focus"/><TextView android:id="@+id/tvYear" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/><TextView android:id="@+id/tvArea" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/><TextView android:id="@+id/tvLang" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/></LinearLayout>
    <TextView android:id="@+id/tvType" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="46px" android:textColor="@color/aether_amber_atmos" android:maxLines="1"/>
    <TextView android:id="@+id/tvActor" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="44px" android:textSize="24px" android:maxLines="1"/>
    <TextView android:id="@+id/tvDirector" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="44px" android:textSize="24px" android:maxLines="1"/>
    <TextView android:id="@+id/tvDes" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="115px" android:lineSpacingMultiplier="1.2" android:textSize="24px" android:maxLines="3" android:textColor="@color/aether_text_secondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="78px" android:gravity="center_vertical"><TextView android:id="@+id/tvQuickSearch" style="@style/UxSceneButton" android:layout_width="300px" android:layout_height="78px" android:drawableLeft="@drawable/ic_tvbox_content_quick_search" android:drawablePadding="8px" android:text="快速搜索" android:textSize="24px"/><TextView android:id="@+id/tvDesc" style="@style/UxSceneButton" android:layout_width="240px" android:layout_height="78px" android:layout_marginLeft="18px" android:drawableLeft="@drawable/ic_tvbox_content_info" android:drawablePadding="8px" android:text="完整简介" android:textSize="24px"/><TextView android:id="@+id/tvPlayUrl" style="@style/UxSceneButton" android:layout_width="330px" android:layout_height="78px" android:layout_marginLeft="18px" android:drawableLeft="@drawable/ic_tvbox_action_copy" android:drawablePadding="8px" android:text="复制播放地址" android:textSize="24px"/></LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="1360px" android:layout_height="1400px" android:layout_marginLeft="1480px" android:layout_marginTop="160px" android:background="@drawable/car_surface_card" android:padding="36px" android:orientation="vertical">
    <TextView style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="48px" android:drawableLeft="@drawable/ic_tvbox_content_source" android:drawablePadding="10px" android:text="播放源 / 线路" android:textColor="@color/aether_text_primary" android:textStyle="bold" android:textSize="30px"/>
    <TextView android:layout_width="match_parent" android:layout_height="40px" android:text="选择来源后显示线路、清晰度和可播放剧集" android:textColor="@color/aether_text_muted" android:textSize="22px"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewFlag" android:layout_width="match_parent" android:layout_height="96px" android:layout_marginTop="12px" app:tv_horizontalSpacingWithMargins="18px" app:tv_selectedItemIsCentered="false"/>
    <LinearLayout android:id="@+id/mSeriesGroupTv" android:layout_width="match_parent" android:layout_height="90px" android:layout_marginTop="20px" android:gravity="center_vertical" android:visibility="gone">
     <TextView android:id="@+id/mSeriesSortTv" style="@style/UxSceneButton" android:layout_width="150px" android:layout_height="80px" android:drawableLeft="@drawable/ic_tvbox_action_sort" android:drawablePadding="6px" android:text="正序" android:nextFocusRight="@id/mSeriesGroupView"/>
     <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mSeriesGroupView" android:layout_width="0px" android:layout_height="90px" android:layout_weight="1" android:layout_marginLeft="20px" app:tv_horizontalSpacingWithMargins="18px" app:tv_selectedItemIsCentered="false"/>
    </LinearLayout>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewQuality" android:layout_width="match_parent" android:layout_height="90px" android:layout_marginTop="12px" android:visibility="gone" app:tv_horizontalSpacingWithMargins="18px"/>
    <LinearLayout android:id="@+id/mEmptyPlaylist" android:layout_width="match_parent" android:layout_height="160px" android:gravity="center" android:visibility="gone"><TextView style="@style/UxSceneText" android:text="暂无可播放剧集，请换源或重新搜索" android:textColor="@color/aether_text_muted" android:textSize="26px"/></LinearLayout>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView" android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:layout_marginTop="22px" android:clipToPadding="true" app:tv_horizontalSpacingWithMargins="20px" app:tv_verticalSpacingWithMargins="22px" app:tv_selectedItemIsCentered="false"/>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <androidx.fragment.app.FragmentContainerView android:id="@+id/previewPlayer" android:layout_width="1360px" android:layout_height="765px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:background="@android:color/black" android:visibility="gone"/>
 <TextView android:id="@+id/previewPlayerBlock" android:layout_width="1360px" android:layout_height="765px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:gravity="center" android:drawableTop="@drawable/ic_tvbox_content_play" android:drawablePadding="8px" android:text="轻触全屏播放" android:textSize="32px" android:textColor="#CCFFFFFF" android:background="@drawable/preview_player_block" android:focusable="true" android:clickable="true" android:nextFocusDown="@id/tvPlay" android:visibility="gone"/>
</FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
