<?xml version="1.0" encoding="utf-8"?>
<com.github.tvbox.osc.car.CarSceneLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/car_bg">
<FrameLayout android:layout_width="2880px" android:layout_height="1620px">
 <LinearLayout android:id="@+id/llLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <FrameLayout android:id="@+id/topLayout" android:layout_width="match_parent" android:layout_height="match_parent">
   <TextView android:id="@+id/uxDetailBack" style="@style/UxSceneButton" android:layout_width="180px" android:layout_height="90px" android:layout_marginLeft="60px" android:layout_marginTop="40px" android:text="‹ 返回" android:textSize="30px"/>
   <TextView android:id="@+id/tvName" style="@style/UxSceneText" android:layout_width="1900px" android:layout_height="90px" android:layout_marginLeft="280px" android:layout_marginTop="40px" android:gravity="center_vertical" android:maxLines="1" android:textSize="36px" android:textStyle="bold"/>
   <TextView style="@style/UxSceneText" android:layout_width="480px" android:layout_height="90px" android:layout_marginLeft="2340px" android:layout_marginTop="40px" android:gravity="center" android:background="@drawable/car_badge_dark" android:text="影片详情 · 选集" android:textColor="@color/car_accent_cyan" android:textSize="26px"/>
   <FrameLayout android:id="@+id/thumbContainer" android:layout_width="1232px" android:layout_height="693px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:background="@drawable/car_surface_card"><ImageView android:id="@+id/ivThumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/></FrameLayout>
   <View android:id="@+id/previewPlayerPlace" android:layout_width="1232px" android:layout_height="693px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:visibility="gone"/>
   <TextView android:id="@+id/tvPlay" style="@style/UxSceneButton" android:layout_width="480px" android:layout_height="140px" android:layout_marginLeft="60px" android:layout_marginTop="880px" android:text="▶ 全屏播放" android:textSize="38px" android:nextFocusUp="@id/previewPlayerBlock"/>
   <TextView android:id="@+id/tvChangeSource" style="@style/UxSceneButton" android:layout_width="270px" android:layout_height="140px" android:layout_marginLeft="570px" android:layout_marginTop="880px" android:text="智能换源" android:textSize="32px"/>
   <TextView android:id="@+id/tvCollect" style="@style/UxSceneButton" android:layout_width="200px" android:layout_height="140px" android:layout_marginLeft="870px" android:layout_marginTop="880px" android:text="加入收藏" android:textSize="30px"/>
   <TextView android:id="@+id/uxDetailCast" style="@style/UxSceneButton" android:layout_width="200px" android:layout_height="140px" android:layout_marginLeft="1100px" android:layout_marginTop="880px" android:text="投屏/推送" android:textSize="28px"/>
   <LinearLayout android:layout_width="1240px" android:layout_height="510px" android:layout_marginLeft="60px" android:layout_marginTop="1050px" android:background="@drawable/car_surface_card" android:padding="30px" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="50px" android:gravity="center_vertical"><TextView android:id="@+id/tvSite" style="@style/UxSceneText" android:maxLines="1" android:textColor="@color/car_accent_cyan"/><TextView android:id="@+id/tvYear" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/><TextView android:id="@+id/tvArea" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/><TextView android:id="@+id/tvLang" style="@style/UxSceneText" android:layout_marginLeft="20px" android:textSize="26px"/></LinearLayout>
    <TextView android:id="@+id/tvType" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="45px" android:textColor="@color/car_accent_amber" android:maxLines="1"/>
    <TextView android:id="@+id/tvActor" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="45px" android:textSize="26px" android:maxLines="1"/>
    <TextView android:id="@+id/tvDirector" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="45px" android:textSize="26px" android:maxLines="1"/>
    <TextView android:id="@+id/tvDes" style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="150px" android:lineSpacingMultiplier="1.2" android:textSize="26px" android:maxLines="3" android:textColor="@color/car_text_dim"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="90px" android:gravity="center_vertical"><TextView android:id="@+id/tvQuickSearch" style="@style/UxSceneButton" android:layout_width="300px" android:layout_height="90px" android:text="快速搜索"/><TextView android:id="@+id/tvDesc" style="@style/UxSceneButton" android:layout_width="240px" android:layout_height="90px" android:layout_marginLeft="20px" android:text="完整简介"/><TextView android:id="@+id/tvPlayUrl" style="@style/UxSceneButton" android:layout_width="300px" android:layout_height="90px" android:layout_marginLeft="20px" android:text="复制播放地址"/></LinearLayout>
   </LinearLayout>
   <LinearLayout android:layout_width="1460px" android:layout_height="1400px" android:layout_marginLeft="1360px" android:layout_marginTop="160px" android:background="@drawable/car_surface_card" android:padding="40px" android:orientation="vertical">
    <TextView style="@style/UxSceneText" android:layout_width="match_parent" android:layout_height="45px" android:text="播放源 / 线路" android:textStyle="bold" android:textSize="30px"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewFlag" android:layout_width="match_parent" android:layout_height="90px" android:layout_marginTop="10px" app:tv_horizontalSpacingWithMargins="18px" app:tv_selectedItemIsCentered="false"/>
    <LinearLayout android:id="@+id/mSeriesGroupTv" android:layout_width="match_parent" android:layout_height="90px" android:layout_marginTop="30px" android:gravity="center_vertical" android:visibility="gone">
     <TextView android:id="@+id/mSeriesSortTv" style="@style/UxSceneButton" android:layout_width="150px" android:layout_height="80px" android:text="正序" android:nextFocusRight="@id/mSeriesGroupView"/>
     <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mSeriesGroupView" android:layout_width="0px" android:layout_height="90px" android:layout_weight="1" android:layout_marginLeft="20px" app:tv_horizontalSpacingWithMargins="18px" app:tv_selectedItemIsCentered="false"/>
    </LinearLayout>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridViewQuality" android:layout_width="match_parent" android:layout_height="90px" android:layout_marginTop="20px" android:visibility="gone" app:tv_horizontalSpacingWithMargins="18px"/>
    <LinearLayout android:id="@+id/mEmptyPlaylist" android:layout_width="match_parent" android:layout_height="200px" android:gravity="center" android:visibility="gone"><TextView style="@style/UxSceneText" android:text="暂无播放数据，请切换源站" android:textColor="@color/car_text_dim"/></LinearLayout>
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/mGridView" android:layout_width="match_parent" android:layout_height="0px" android:layout_weight="1" android:layout_marginTop="30px" android:clipToPadding="true" app:tv_horizontalSpacingWithMargins="20px" app:tv_verticalSpacingWithMargins="22px" app:tv_selectedItemIsCentered="false"/>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <androidx.fragment.app.FragmentContainerView android:id="@+id/previewPlayer" android:layout_width="1232px" android:layout_height="693px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:background="@android:color/black" android:visibility="gone"/>
 <TextView android:id="@+id/previewPlayerBlock" android:layout_width="1232px" android:layout_height="693px" android:layout_marginLeft="60px" android:layout_marginTop="160px" android:gravity="center" android:text="▶\n轻触全屏播放" android:textSize="32px" android:textColor="#CCFFFFFF" android:background="@drawable/preview_player_block" android:focusable="true" android:clickable="true" android:nextFocusDown="@id/tvPlay" android:visibility="gone"/>
</FrameLayout>
</com.github.tvbox.osc.car.CarSceneLayout>
