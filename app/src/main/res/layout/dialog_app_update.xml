<?xml version="1.0" encoding="utf-8"?>
<!-- 软件更新弹窗：与原「配置地址/指定搜索源」同一套底板、标题字号与按钮样式。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:padding="@dimen/vs_24">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="软件更新"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 当前版本 / 最新版本对比 -->
        <TextView
            android:id="@+id/tvVersions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_12"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <!-- 更新说明（Release 正文） -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="@dimen/vs_300"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvVersions">

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </ScrollView>

        <!-- 下载进度：只在下载中出现 -->
        <LinearLayout
            android:id="@+id/progressBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scroll">

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_12"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="@android:color/darker_gray"
                android:progressTint="@android:color/white" />

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <!-- 状态 / 错误提示 -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_22"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBox" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHint">

            <TextView
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_detail_play"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_12"
                android:text="立即更新"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_12"
                android:text="关闭"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <!-- 次要操作：跳过此版本 / 浏览器手动下载（应用内下载失败时的兜底） -->
        <LinearLayout
            android:id="@+id/subButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttons">

            <TextView
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="跳过此版本"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnManual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_10"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="浏览器下载"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
