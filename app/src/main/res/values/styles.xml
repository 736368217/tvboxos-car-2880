<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Car edition (CAR-UI-SPEC-TVBOX-2880x1620 §5.3): dark immersive palette. -->
        <item name="colorPrimary">@color/car_card</item>
        <item name="colorPrimaryDark">@color/car_bg</item>
        <item name="colorAccent">@color/car_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>//全屏即无通知栏
        <item name="android:windowContentOverlay">@null</item>//是否有遮盖
        <item name="windowNoTitle">true</item>
        <item name="android:keepScreenOn">true</item>
        <!--        <item name="android:windowBackground">@drawable/main_bg</item>-->
        <item name="android:windowBackground">@color/car_bg</item>
    </style>
    <!-- 自定义dialog样式 -->
    <style name="CustomDialogStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="CustomDialogStyleDim" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="CarHomeShortcut">
        <item name="android:layout_width">180mm</item>
        <item name="android:layout_height">@dimen/vs_90</item>
        <item name="android:layout_marginLeft">@dimen/vs_8</item>
        <item name="android:layout_marginRight">@dimen/vs_8</item>
        <item name="android:background">@drawable/shape_user_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CarHomeShortcutIcon">
        <item name="android:layout_width">@dimen/vs_40</item>
        <item name="android:layout_height">@dimen/vs_40</item>
        <item name="android:alpha">0.8</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CarHomeShortcutLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/vs_10</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/color_CCFFFFFF</item>
        <item name="android:textSize">@dimen/ts_30</item>
    </style>

    <style name="CarAdvancedSwitch">
        <item name="android:layout_width">@dimen/vs_80</item>
        <item name="android:layout_height">@dimen/vs_50</item>
        <item name="android:minWidth">@dimen/vs_70</item>
        <item name="android:minHeight">@dimen/vs_50</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CarAdvancedMenuIcon">
        <item name="android:layout_width">@dimen/vs_24</item>
        <item name="android:layout_height">@dimen/vs_24</item>
        <item name="android:layout_marginLeft">@dimen/vs_10</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="CarPlayerQuickControl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/vs_50</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginRight">@dimen/vs_12</item>
        <item name="android:background">@drawable/button_dialog_main</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/ts_19</item>
    </style>

    <style name="CarAdvancedRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/vs_60</item>
        <item name="android:layout_marginBottom">@dimen/vs_12</item>
        <item name="android:background">@drawable/shape_setting_model_focus</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/vs_20</item>
        <item name="android:paddingRight">@dimen/vs_20</item>
    </style>

    <style name="CarAdvancedLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/ts_22</item>
    </style>

    <style name="CarAdvancedValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_CCFFFFFF</item>
        <item name="android:textSize">@dimen/ts_20</item>
    </style>

    <style name="CarAdvancedChevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/vs_10</item>
        <item name="android:textColor">@color/color_CCFFFFFF</item>
        <item name="android:textSize">@dimen/ts_28</item>
    </style>

    <style name="CarAdvancedWeight">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="epg_window_btn">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/item_bg_selector_right</item>
        <item name="android:paddingLeft">0mm</item>
        <item name="android:paddingRight">0mm</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">5mm</item>
        <item name="android:radius">5mm</item>
    </style>
</resources>
